node_modules/
.DS_Store
Thumbs.db
*.log
.playwright-mcp/

# Журналы с телефона лежат локально: репозиторий публичный,
# а это записи о ребёнке. Папка и её README в репозитории остаются.
logs/*
!logs/README.md

# Записи точек скелета с телефона — это движения ребёнка, а репозиторий
# публичный. Папка и README остаются, содержимое нет.
fixtures/*
!fixtures/README.md

# Промежуточные файлы конвейера арта: init-кадры и то, что вернула
# нейросеть. Восстанавливаются за минуту из tools/frame.html и
# tools/ed-generate.mjs, а в приложение уходит только сжатый assets/*.webp.
tools/init/
tools/painted/
